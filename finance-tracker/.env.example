# --------- Backend Configuration (Railway) ---------
# The port the Go server listens on
PORT=8080

# Supabase Postgres connection URL (with pooling `?pgbouncer=true` recommended for Railway to Supabase)
DATABASE_URL=postgres://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Secret for generating and validating user sessions
JWT_SECRET=your-super-strong-jwt-secret-here

# Mode for Go server ('debug' or 'release')
GIN_MODE=release

# The domain of the frontend app deployed on Vercel to allow CORS
ALLOWED_ORIGIN=https://my-finance-tracker.vercel.app

# Secret required to trigger the cron update-rates endpoint via the X-CRON-KEY header
CRON_SECRET=super-secret-cron-key


# --------- Frontend Configuration (Vercel) ---------
# In Vercel, put this as an Environment Variable.
# The build script replaces this value in script.js if it matches the pattern __API_BASE_URL__.
API_BASE_URL=https://my-finance-backend.up.railway.app/api/v1
